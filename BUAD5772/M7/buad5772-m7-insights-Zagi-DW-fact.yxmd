            <SpatialObjSize>8000</SpatialObjSize>
            <TransactionSize>10000</TransactionSize>
            <IgnoreDropTableSQLErrors>False</IgnoreDropTableSQLErrors>
            <PostSQL><![CDATA[ALTER TABLE `zagi_dw`.`fact_sales` 
CHANGE COLUMN `Customer_Key` `Customer_Key` INT(11) NOT NULL ,
CHANGE COLUMN `Store_key` `Store_key` INT(11) NOT NULL ,
CHANGE COLUMN `Product_Key` `Product_Key` INT(11) NOT NULL ,
CHANGE COLUMN `CalendarKey` `CalendarKey` INT(11) NOT NULL ,
ADD PRIMARY KEY (`Customer_Key`, `Store_key`, `Product_Key`, `CalendarKey`);
;

ALTER TABLE `zagi_dw`.`fact_sales` 
ADD INDEX `fkcal_idx` (`CalendarKey` ASC) VISIBLE,
ADD INDEX `fkprod_idx` (`Product_Key` ASC) VISIBLE,
ADD INDEX `fkstore_idx` (`Store_key` ASC) VISIBLE;
;
ALTER TABLE `zagi_dw`.`fact_sales` 
ADD CONSTRAINT `fkcal`
  FOREIGN KEY (`CalendarKey`)
  REFERENCES `zagi_dw`.`dim_calendar` (`CalendarKey`)
  ON DELETE NO ACTION
  ON UPDATE NO ACTION,
ADD CONSTRAINT `fkprod`
  FOREIGN KEY (`Product_Key`)
  REFERENCES `zagi_dw`.`dim_product` (`Product_Key`)
  ON DELETE NO ACTION
  ON UPDATE NO ACTION,
ADD CONSTRAINT `fkstore`
  FOREIGN KEY (`Store_key`)
  REFERENCES `zagi_dw`.`dim_store` (`Store_key`)
  ON DELETE NO ACTION
  ON UPDATE NO ACTION,
ADD CONSTRAINT `fkcust`
  FOREIGN KEY (`Customer_Key`)
  REFERENCES `zagi_dw`.`dim_customer` (`Customer_Key`)
  ON DELETE NO ACTION
  ON UPDATE NO ACTION;

]]></PostSQL>
            <TableStyle>Quoted</TableStyle>
            <PreSQL>use zagi_dw;
drop table if exists fact_sales;</PreSQL>
